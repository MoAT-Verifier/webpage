# Public site URL. Drives canonical URLs, the sitemap, and Open Graph metadata.
PUBLIC_SITE_URL=https://moat.verify.rwth-aachen.de

# Base URL of the MoAT analysis service (the `webinterface` repository).
# The /interface/ page posts programs here; leaving it unset falls back to the
# production host. Baked in at build time, so changing it needs a rebuild.
PUBLIC_MOAT_API_URL=https://moat-api.verify.rwth-aachen.de
