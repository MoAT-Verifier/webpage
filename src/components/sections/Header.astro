---
import Button from "@/components/ui/Button.astro";
import Logo from "@/components/ui/Logo.astro";
import { siteConfig } from "@/config/site";
import menus from "@/data/menu.json";
import { ChevronRight, Menu, Moon, SunMedium, X } from "@lucide/astro";

const menuItems = menus as Array<{ name: string; url: string }>;
---

<!-- The header is fixed, so this stands in for its height in the flow. -->
<div class="relative w-full h-16 sm:h-20 opacity-0 pointer-events-none"></div>
<header id="header" class="fixed top-2 sm:top-4 z-50 w-full px-3 sm:px-4 lg:px-6">
  <div id="site-container"
    class="flex items-center justify-between h-14 sm:h-15 site-container mx-auto px-4 sm:px-6 py-2.5 border-transparent border-[0.5px] transition-all duration-300"
  >
    <div class="flex-shrink-0 z-50">
      <Logo />
    </div>

    <div
      id="mobileMenuBackground"
      class="fixed inset-0 z-20 hidden w-screen h-screen duration-300 ease-out bg-white/90 backdrop-blur-sm dark:bg-neutral-950/90"
    >
    </div>

    <nav
      class="relative z-30 flex flex-row-reverse justify-start w-full text-sm sm:justify-end text-neutral-500 dark:text-neutral-400 sm:flex-row sm:items-center"
    >
      <div class="flex items-center gap-2 sm:hidden">
        <div
          id="darkToggleMobile"
          class="flex items-center justify-center w-10 h-10 cursor-pointer rounded-full bg-gradient-to-b from-white to-bg-primary-light border-[0.5px] border-primary/10 dark:from-neutral-800 dark:to-bg-secondary-dark dark:border-neutral-600 transition-transform duration-200 active:scale-95"
        >
          <div
            class="flex justify-center items-center w-6 h-6 relative overflow-hidden rounded-full bg-primary border-[0.5px] border-primary-light"
            style="box-shadow: 0px 2px 3px 0 rgba(var(--color-primary-rgb),0.21);"
          >
            <SunMedium
              class="absolute hidden text-btn-primary-text w-4 h-4 transition duration-200 transform ease mobile-sun" />
            <Moon
              class="absolute hidden text-btn-primary-text w-4 h-4 transition duration-200 transform ease mobile-moon" />
          </div>
        </div>

        <button
          type="button"
          id="openMenu"
          aria-label="Open menu"
          class="flex items-center justify-center w-10 h-10 cursor-pointer rounded-full bg-gradient-to-b from-white to-bg-primary-light border-[0.5px] border-primary/10 dark:from-neutral-800 dark:to-bg-secondary-dark dark:border-neutral-600 transition-all duration-200 hover:shadow-md active:scale-90"
        >
          <Menu class="w-5 h-5 text-neutral-700 dark:text-neutral-200" stroke-width={2} />
        </button>

        <button
          type="button"
          id="closeMenu"
          aria-label="Close menu"
          class="hidden items-center justify-center w-10 h-10 cursor-pointer rounded-full bg-gradient-to-b from-white to-bg-primary-light border-[0.5px] border-primary/10 dark:from-neutral-800 dark:to-bg-secondary-dark dark:border-neutral-600 transition-all duration-200 hover:shadow-md active:scale-90"
        >
          <X class="w-5 h-5 text-neutral-700 dark:text-neutral-200" stroke-width={2} />
        </button>
      </div>

      <div
        id="menu"
        class="fixed top-[68px] sm:top-0 left-3 right-3 sm:left-0 sm:right-0 ease-out duration-300 z-40 flex-col items-center justify-start hidden w-auto max-h-[calc(100dvh-84px)] overflow-y-auto text-sm pt-4 pb-4 sm:max-h-none sm:overflow-visible sm:py-0 sm:relative sm:flex-row sm:flex"
      >
        <div
          class="absolute inset-0 top-0 right-0 block w-full h-full sm:hidden"
        >
          <div
            class="relative w-full h-full bg-white/95 dark:bg-bg-primary-dark/95 border border-dashed border-neutral-300 dark:border-neutral-700 backdrop-blur-md rounded-2xl shadow-lg"
          >
          </div>
        </div>

        <div class="relative z-10 flex flex-col sm:flex-row items-stretch sm:items-center w-full sm:w-auto px-2 sm:px-0 gap-0.5 sm:gap-0">
          <div class="block sm:hidden px-3 pt-1 pb-2">
            <span class="text-[10px] font-medium uppercase tracking-[0.14em] text-neutral-400 dark:text-neutral-500">Navigation</span>
          </div>
          {
            menuItems.map((menu) => (
              <a
                href={menu.url}
                class="group relative flex items-center justify-between sm:justify-center w-full sm:w-auto px-3 py-3 sm:py-2 sm:px-3 md:px-4 font-medium tracking-wide duration-200 ease-out rounded-lg sm:rounded-none text-neutral-700 dark:text-neutral-200 hover:text-primary hover:bg-primary/5 sm:hover:bg-transparent dark:hover:text-white dark:hover:bg-primary/10 sm:dark:hover:bg-transparent active:scale-[0.98] sm:active:scale-100 transition-all text-left sm:text-center"
              >
                <span>{menu.name}</span>
                <ChevronRight class="w-4 h-4 sm:hidden text-neutral-300 dark:text-neutral-600 group-hover:text-primary group-hover:translate-x-0.5 transition-all" />
              </a>
            ))
          }
        </div>

        <div class="relative z-10 w-full px-5 sm:hidden mt-3">
          <div class="w-full border-t border-dashed border-neutral-200 dark:border-neutral-700"></div>
        </div>

        <div class="relative z-10 w-full px-5 mt-3 sm:hidden">
          <Button url={siteConfig.social.github || "javascript:void(0);"} type="fill" target="_blank" className="m-auto w-full justify-center ">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-astro-cid-gfykqide="true" class="lucide lucide-github"> <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"></path><path d="M9 18c-4.51 2-5-2-7-2"></path>  </svg>  Star on GitHub
          </Button>
        </div>
      </div>

      <div class="relative hidden sm:flex items-center gap-2 ml-4 lg:ml-6">
        <Button url={siteConfig.social.github || "javascript:void(0);"} target="_blank"  type="fill" className="md:flex mx-1">
                   <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-astro-cid-gfykqide="true" class="lucide lucide-github"> <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"></path><path d="M9 18c-4.51 2-5-2-7-2"></path>  </svg> GitHub
        </Button>

        <span class="separator-line hidden sm:inline-block bg-primary/25 mt-[20px] -translate-y-1/2 w-px h-[20px]"></span>

        <div
          id="darkToggle"
          class="relative flex items-center h-9 px-2 gap-1.5 font-medium cursor-pointer rounded-full bg-gradient-to-b from-white to-bg-primary-light border-[0.5px] border-primary/10 dark:from-neutral-800 dark:to-bg-secondary-dark dark:border-neutral-600 transition-all duration-200 hover:shadow-md hover:scale-105 active:scale-95 mx-1"
        >
          <div
            class="flex justify-center items-center flex-shrink-0 w-6 h-6 relative overflow-hidden rounded-full bg-primary border-[0.5px] border-primary-light"
            style="box-shadow: 0px 2px 3px 0 rgba(var(--color-primary-rgb),0.21);"
          >
            <SunMedium id="sun"
               class="absolute hidden text-btn-primary-text w-4 h-4 transition duration-200 transform ease" />
            <Moon class="absolute hidden text-btn-primary-text w-4 h-4 transition duration-200 transform ease"
              id="moon" />
          </div>
          <span class="hidden sm:inline-block whitespace-nowrap">
            <span id="dayText" class="flex-shrink-0 text-sm text-left text-neutral-600 dark:text-neutral-400">Light</span>
            <span id="nightText" class="hidden flex-shrink-0 text-sm text-left text-neutral-600 dark:text-neutral-400">Dark</span>
          </span>
        </div>
      </div>
    </nav>
  </div>
</header>

<style>
  #header {
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  @media (max-width: 639px) {
    #menu {
      /* 12px of margin on each side. */
      max-width: calc(100vw - 24px);
      transform: translateY(-10px);
      opacity: 0;
      pointer-events: none;
      transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }

    #menu:not(.hidden) {
      transform: translateY(0);
      opacity: 1;
      pointer-events: auto;
    }

    /* Staggered entrance for the menu items. */
    #menu:not(.hidden) > div > a {
      animation: menuItemIn 0.4s cubic-bezier(0.4, 0, 0.2, 1) both;
    }
    #menu:not(.hidden) > div > a:nth-child(2) { animation-delay: 0.05s; }
    #menu:not(.hidden) > div > a:nth-child(3) { animation-delay: 0.1s; }
    #menu:not(.hidden) > div > a:nth-child(4) { animation-delay: 0.15s; }
    #menu:not(.hidden) > div > a:nth-child(5) { animation-delay: 0.2s; }
    #menu:not(.hidden) > div > a:nth-child(6) { animation-delay: 0.25s; }
  }

  @keyframes menuItemIn {
    from {
      opacity: 0;
      transform: translateX(-8px);
    }
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #menu:not(.hidden) > div > a {
      animation: none;
    }
  }

  nav a {
    position: relative;
  }

  /* Underline that grows from the middle on hover, desktop only. */
  @media (min-width: 640px) {
    nav a::after {
      content: '';
      position: absolute;
      bottom: 0;
      left: 50%;
      transform: translateX(-50%) scaleX(0);
      width: 70%;
      height: 2px;
      background: var(--color-primary);
      transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
      border-radius: 2px;
    }

    nav a:hover::after {
      transform: translateX(-50%) scaleX(1);
    }
  }

  /* Touch feedback on a menu item. */
  @media (max-width: 639px) {
    nav a:active {
      background-color: var(--color-neutral-100);
    }

    .dark nav a:active {
      background-color: rgba(255, 255, 255, 0.05);
    }
  }

  #darkToggle,
  #darkToggleMobile {
    user-select: none;
    -webkit-tap-highlight-color: transparent;
  }

  @supports (backdrop-filter: blur(12px)) {
    #mobileMenuBackground {
      backdrop-filter: blur(12px);
    }

    @media (max-width: 639px) {
      #menu > div > div {
        backdrop-filter: blur(16px);
      }
    }
  }

  /* Keeps the logo from shrinking on narrow screens. */
  .flex-shrink-0 {
    min-width: fit-content;
  }

  /* Tablet: the five items only fit at a smaller size. */
  @media (min-width: 640px) and (max-width: 767px) {
    nav a {
      padding-left: 0.5rem;
      padding-right: 0.5rem;
      font-size: 0.8125rem;
    }
  }

  @media (max-width: 639px) {
    button, a, [role="button"] {
      -webkit-tap-highlight-color: transparent;
    }

    #mobileMenuBackground {
      opacity: 0;
      transition: opacity 0.3s ease-out;
    }

    #mobileMenuBackground:not(.hidden) {
      opacity: 1;
    }
  }
</style>

<script is:inline>
  // The header card only grows its border and blur once the page has scrolled
  // away from the top; at the top it is meant to sit on the background.
  const headerCard = document.getElementById('site-container');
  const STUCK = [
    'shadow-[0px_1px_4px_0_rgba(25,33,61,0.06)]',
    'rounded-[20px]',
    'bg-bg-secondary/65',
    'border-bg-secondary/65',
    'dark:border-primary/20',
    'dark:bg-bg-secondary-dark/70',
    'backdrop-blur-2xl',
    'backdrop-brightness-120',
  ];
  const UNSTUCK = ['shadow-none', 'border-transparent', 'rounded-none', 'bg-transparent'];

  function evaluateHeaderPosition() {
    const stuck = window.scrollY > 48;
    headerCard?.classList.add(...(stuck ? STUCK : UNSTUCK));
    headerCard?.classList.remove(...(stuck ? UNSTUCK : STUCK));
  }

  window.addEventListener('scroll', evaluateHeaderPosition, { passive: true });
  evaluateHeaderPosition();

  // Mark the entry for the page being viewed.
  document.querySelectorAll('#menu a').forEach((link) => {
    if (link.pathname === window.location.pathname) {
      link.classList.add('text-neutral-900', 'dark:text-white');
      link.setAttribute('aria-current', 'page');
    }
  });

  // Dark mode. The class itself is set before paint by the boot script in
  // Layout.astro, which reads the same localStorage key.
  const darkToggle = document.getElementById('darkToggle');
  const darkToggleMobile = document.getElementById('darkToggleMobile');

  function syncDarkModeIcons() {
    const isDark = document.documentElement.classList.contains('dark');
    const sunIcons = document.querySelectorAll('#sun, .mobile-sun');
    const moonIcons = document.querySelectorAll('#moon, .mobile-moon');

    if (isDark) {
      moonIcons.forEach(icon => icon.classList.remove('hidden'));
      sunIcons.forEach(icon => icon.classList.add('hidden'));
      document.getElementById('dayText')?.classList.add('hidden');
      document.getElementById('nightText')?.classList.remove('hidden');
    } else {
      sunIcons.forEach(icon => icon.classList.remove('hidden'));
      moonIcons.forEach(icon => icon.classList.add('hidden'));
      document.getElementById('dayText')?.classList.remove('hidden');
      document.getElementById('nightText')?.classList.add('hidden');
    }
  }

  syncDarkModeIcons();

  darkToggle?.addEventListener('click', () => {
    const dark = !document.documentElement.classList.contains('dark');
    document.documentElement.classList.toggle('dark', dark);
    try {
      if (dark) localStorage.setItem('dark_mode', 'true');
      else localStorage.removeItem('dark_mode');
    } catch {}
    syncDarkModeIcons();
  });

  darkToggleMobile?.addEventListener('click', () => {
    darkToggle?.click();
  });

  const openMenu = document.getElementById('openMenu');
  const closeMenu = document.getElementById('closeMenu');
  const menu = document.getElementById('menu');
  const mobileMenuBackground = document.getElementById('mobileMenuBackground');

  function openMobileMenu() {
    menu?.classList.remove('hidden');
    mobileMenuBackground?.classList.remove('hidden');
    openMenu?.classList.add('hidden');
    closeMenu?.classList.remove('hidden');
    closeMenu?.classList.add('flex');
    // Keep the page behind the overlay from scrolling.
    document.body.style.overflow = 'hidden';
  }

  function closeMobileMenu() {
    menu?.classList.add('hidden');
    mobileMenuBackground?.classList.add('hidden');
    closeMenu?.classList.add('hidden');
    closeMenu?.classList.remove('flex');
    openMenu?.classList.remove('hidden');
    document.body.style.overflow = '';
  }

  openMenu?.addEventListener('click', openMobileMenu);
  closeMenu?.addEventListener('click', closeMobileMenu);
  mobileMenuBackground?.addEventListener('click', closeMobileMenu);

  menu?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => {
      if (window.innerWidth < 640) closeMobileMenu();
    });
  });

  // `hidden` is what closes the menu on mobile, but on desktop the same class
  // would hide the navigation altogether, so widening has to drop it.
  window.addEventListener('resize', () => {
    if (window.innerWidth >= 640) {
      document.body.style.overflow = '';
      menu?.classList.remove('hidden');
    }
  });
</script>
