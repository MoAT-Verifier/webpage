---
import Footer from "@/components/sections/Footer.astro";
import Header from "@/components/sections/Header.astro";
import TopBg from "@/components/ui/TopBg.astro";
import Meta from "./Meta.astro";
interface Props {
	title?: string | undefined;
	description?: string | undefined;
	keywords?: string | undefined;
}

const { title, description, keywords } = Astro.props;

import "../styles/global.css";
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <Meta
      title = {title}
      description = {description}
      keywords = {keywords}
    />
    <!-- Apply dark mode before paint to prevent flicker. -->
    <script is:inline>
      try {
        if (window.localStorage.getItem('dark_mode') === 'true') {
          document.documentElement.classList.add('dark');
        }
      } catch {}
    </script>

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body class="antialiased bg-bg-primary dark:bg-bg-primary-dark max-w-full overflow-x-hidden">
    <TopBg />
    <Header />
    <slot />
    <Footer />
  </body>
</html>
