---
import PageHeader from "@/components/elements/PageHeader.astro";
import PublicationList from "@/components/elements/PublicationList.astro";
import bibSource from "@/data/publications.bib?raw";
import Layout from "@/layouts/Layout.astro";
import { toPublications } from "@/lib/publications";
import { ExternalLink } from "@lucide/astro";

// Single source of truth: add or edit entries in src/data/publications.bib.
const publications = toPublications(bibSource);

const backends = [
	{
		name: "KoAT",
		role: "Proves fair termination in MoAT's backend.",
		desc: "A tool to automatically infer complexity bounds for (probabilistic) integer programs, based on an alternating modular inference of upper runtime and size bounds for program parts.",
		url: "https://koat.verify.rwth-aachen.de/",
		label: "koat.verify.rwth-aachen.de",
	},
	{
		name: "LoAT",
		role: "Disproves fair termination in MoAT's backend.",
		desc: "Proves non-termination and lower runtime bounds for integer programs, searching for reachable non-terminating cycles via an acceleration driven clause learning calculus.",
		url: "https://loat-developers.github.io/LoAT/",
		label: "loat-developers.github.io/LoAT",
	},
	{
		name: "Spot",
		role: "Generates the Büchi automata used by MoAT.",
		desc: "A library for LTL and ω-automata manipulation, producing optimized transition-based accepting Büchi automata.",
		url: "https://spot.lre.epita.fr/",
		label: "spot.lre.epita.fr",
	},
];
---

<Layout
	title="Publications - MoAT"
	description="Publications about MoAT, the tools it builds on, and the tools it was compared against."
	keywords="MoAT publications, LTL model checking paper, fair termination, KoAT, LoAT, Spot"
>
	<main class="site-container">
		<PageHeader
			title="Publications"
			description="The paper behind MoAT, together with the tools it builds on and the tools it was evaluated against."
		/>

		<div class="mx-auto max-w-3xl pb-8">
			<!-- Main paper -->
			<section class="mb-16">
				<PublicationList entries={publications} />
			</section>

			<section class="mb-16">
				<h2 class="mb-3 font-brand text-3xl tracking-normal">Tools MoAT builds on</h2>
				<p class="mb-6 text-base leading-relaxed text-neutral-600 dark:text-neutral-300">
					MoAT is a framework: the heavy lifting is done by established tools, each with its own
					publications and project page.
				</p>

				<div class="space-y-4">
					{backends.map((tool) => (
						<div class="rounded-xl border border-primary/10 bg-bg-primary/50 p-5 dark:border-neutral-700 dark:bg-neutral-800/30">
							<div class="mb-1 flex flex-wrap items-baseline gap-x-3 gap-y-1">
								<h3 class="font-brand text-xl text-neutral-800 dark:text-neutral-100">
									{tool.name}
								</h3>
								<span class="text-xs text-neutral-500 dark:text-neutral-400">{tool.role}</span>
							</div>
							<p class="mb-3 text-sm leading-relaxed text-neutral-600 dark:text-neutral-300">
								{tool.desc}
							</p>
							<a
								href={tool.url}
								target="_blank"
								rel="noopener"
								class="inline-flex items-center gap-1.5 text-sm font-medium text-primary hover:underline dark:text-primary-light"
							>
								{tool.label} <ExternalLink size={13} />
							</a>
						</div>
					))}
				</div>
			</section>

		</div>
	</main>
</Layout>
