---
import PageHeader from "@/components/elements/PageHeader.astro";
import { siteConfig } from "@/config/site";
import Layout from "@/layouts/Layout.astro";
import {
	CircleStop,
	ExternalLink,
	FileUp,
	Info,
	Play,
	RotateCcw,
} from "@lucide/astro";

// The service that actually runs MoAT lives in the `webinterface` repository
// and is deployed separately; this page is static and talks to it over
// fetch(). PUBLIC_MOAT_API_URL is set in the deploy workflow.
const apiUrl = siteConfig.api.url;

// Shown before /api/v1/info answers; the server states the real default.
const terminationFormula = "F 'AT(l_TERM)'";

// The operator legend. Rendered from arrays rather than written out as markup
// because Astro drops a whitespace-only text node that spans a line break, so
// `</code>` at the end of one line and `<code>` at the start of the next run
// together — and the formatter is free to rewrap the list at any time. The
// separators below are expression values, whose spaces always survive.
const temporalOperators = ["X", "F", "G", "U", "R"];
const booleanOperators = ["&&", "||", "->", "NOT"];

const separator = (index: number, total: number) =>
	index === 0 ? "" : index === total - 1 ? ", and " : ", ";

// Each example carries its whole query, so choosing one sets the mode too.
// Recurrence is MoAT's own: `G F 'x <= 0'` over example01.ari is the
// invocation its README uses to illustrate the formula syntax. Overflow is a
// two-variable instance of the property class of the same name in the paper's
// evaluation; `--variables="x y"` is what maps x and y onto Arg_0 and Arg_1.
const examples = [
	{
		name: "Terminating Loop",
		summary: "while (x > 0) x = x - 1;",
		mode: "termination",
		formula: terminationFormula,
		variables: "",
		precondition: "",
		program: `(format LCTRS)
(theory Ints)
(fun l0 (-> Int Int))
(fun l1 (-> Int Int))
(entrypoint l0)
(rule (l0 Arg_0) (l1 Arg_0))
(rule (l1 Arg_0) (l1 (- Arg_0 1)) :guard (> Arg_0 0))
`,
	},
	{
		name: "Non-Terminating Loop",
		summary: "while (x > 0) x = x + 1;",
		mode: "termination",
		formula: terminationFormula,
		variables: "",
		precondition: "",
		program: `(format LCTRS)
(theory Ints)
(fun l0 (-> Int Int))
(fun l1 (-> Int Int))
(entrypoint l0)
(rule (l0 Arg_0) (l1 Arg_0))
(rule (l1 Arg_0) (l1 (+ Arg_0 1)) :guard (> Arg_0 0))
`,
	},
	{
		name: "Overflow",
		summary: "Do x and y stay inside the signed 32-bit range?",
		mode: "property",
		formula: "G ('x <= 2147483647' && 'y >= -2147483648')",
		variables: "x y",
		precondition: "'0 <= x' && 'x <= 100' && '0 <= y' && 'y <= 100'",
		program: `(format LCTRS)
(theory Ints)
(fun l0 (-> Int Int Int))
(fun l1 (-> Int Int Int))
(entrypoint l0)
(rule (l0 Arg_0 Arg_1) (l1 Arg_0 Arg_1))
(rule (l1 Arg_0 Arg_1) (l1 (+ Arg_0 1) (- Arg_1 1)) :guard (> Arg_1 0))
`,
	},
];
---

<Layout
	title="Web Interface - MoAT"
	description="Check an LTL Property of an Integer Transition System with MoAT, in your Browser."
	keywords="MoAT web interface, LTL model checking online, termination checker, integer transition system, ARI format"
>
	<main class="site-container">
		<PageHeader
			title="Web Interface"
			description="Submit an integer transition system and an LTL formula, and let MoAT decide whether the formula holds."
		/>

		<div class="mx-auto max-w-4xl pb-8">
			<form id="moat-form" data-api={apiUrl} data-mode="termination" novalidate>
				<!-- Program -->
				<div
					class="mb-5 rounded-xl border border-primary/10 bg-bg-primary/50 p-5 dark:border-neutral-700 dark:bg-neutral-800/30"
				>
					<div class="mb-4 flex flex-wrap items-center justify-between gap-3">
						<div class="flex flex-wrap items-center gap-2">
							<span
								class="mr-1 text-xs font-medium uppercase tracking-wider text-neutral-500 dark:text-neutral-400"
							>
								Examples
							</span>
							{
								examples.map((example, index) => (
									<button
										type="button"
										class="example-btn rounded-lg border border-primary/20 bg-bg-secondary/60 px-3 py-1.5 text-xs font-medium text-neutral-700 transition-colors hover:border-primary hover:text-primary dark:border-neutral-600 dark:bg-neutral-800/60 dark:text-neutral-200 dark:hover:border-primary-light dark:hover:text-primary-light"
										data-example={index}
										title={example.summary}
									>
										{example.name}
									</button>
								))
							}
						</div>
						<div class="flex items-center gap-2">
							<label
								class="inline-flex cursor-pointer items-center gap-1.5 rounded-lg border border-primary/20 bg-bg-secondary/60 px-3 py-1.5 text-xs font-medium text-neutral-700 transition-colors hover:border-primary hover:text-primary dark:border-neutral-600 dark:bg-neutral-800/60 dark:text-neutral-200 dark:hover:border-primary-light dark:hover:text-primary-light"
							>
								<FileUp class="h-3.5 w-3.5" />
								Upload
								<input id="moat-file" type="file" accept=".ari,.txt" class="hidden" />
							</label>
							<button
								type="button"
								id="moat-reset"
								class="inline-flex items-center gap-1.5 rounded-lg border border-primary/20 bg-bg-secondary/60 px-3 py-1.5 text-xs font-medium text-neutral-700 transition-colors hover:border-primary hover:text-primary dark:border-neutral-600 dark:bg-neutral-800/60 dark:text-neutral-200 dark:hover:border-primary-light dark:hover:text-primary-light"
							>
								<RotateCcw class="h-3.5 w-3.5" />
								Reset
							</button>
						</div>
					</div>

					<label for="moat-program" class="sr-only">Program in ARI format</label>
					<textarea
						id="moat-program"
						name="program"
						rows="16"
						spellcheck="false"
						autocomplete="off"
						autocapitalize="off"
						autocorrect="off"
						wrap="off"
						class="w-full resize-y overflow-x-auto rounded-lg border border-primary/15 bg-white p-4 font-mono text-[13px] leading-relaxed text-neutral-800 outline-none transition-colors focus:border-primary/50 dark:border-neutral-700 dark:bg-neutral-950/60 dark:text-neutral-100 dark:focus:border-primary-light/50"
					></textarea>

					<div class="mt-4 flex flex-wrap items-end justify-between gap-4">
						<div>
							<label
								for="moat-timeout"
								class="mb-1.5 block text-xs font-medium uppercase tracking-wider text-neutral-500 dark:text-neutral-400"
							>
								Timeout
							</label>
							<div class="flex items-center gap-2">
								<input
									id="moat-timeout"
									type="number"
									value="30"
									min="10"
									max="60"
									step="5"
									class="w-24 rounded-lg border border-primary/15 bg-white px-3 py-2 font-mono text-sm text-neutral-800 outline-none focus:border-primary/50 dark:border-neutral-700 dark:bg-neutral-950/60 dark:text-neutral-100"
								/>
								<span id="moat-timeout-hint" class="text-xs text-neutral-500 dark:text-neutral-400">
									seconds
								</span>
							</div>
						</div>
						<p id="moat-size" class="text-xs text-neutral-500 dark:text-neutral-400"></p>
					</div>
				</div>

				<!-- What this does -->
				<div
					class="mb-5 flex gap-4 rounded-xl border border-dashed border-primary/30 bg-bg-secondary/50 p-5 dark:border-neutral-600 dark:bg-neutral-900/40"
				>
					<Info class="mt-0.5 h-5 w-5 flex-none text-primary dark:text-primary-light" />
					<div class="text-sm leading-relaxed text-neutral-600 dark:text-neutral-300">
						<p class="mb-1 font-semibold text-neutral-800 dark:text-neutral-100">
							Choose a property, or keep the default termination check.
						</p>
						<p>
							Atomic propositions are polynomial inequations like <code
								class="rounded bg-primary/10 px-1.5 py-0.5 font-mono text-[13px] text-primary dark:bg-primary/20 dark:text-primary-light"
								>'x &gt; 0'</code
							> or locations like <code
								class="rounded bg-primary/10 px-1.5 py-0.5 font-mono text-[13px] text-primary dark:bg-primary/20 dark:text-primary-light"
								>'AT(l0)'</code
							>, always in single quotes. All operators have the <em>same</em> precedence and associate to
							the left, so parenthesise where the grouping matters. Programs are written in the <a
								href="/getting_started/"
								class="font-medium text-primary hover:underline dark:text-primary-light">ARI format</a
							>.
						</p>
					</div>
				</div>

				<!-- Mode -->
				<div class="mb-5 flex flex-wrap items-center gap-3">
					<div
						class="inline-flex rounded-xl border border-primary/20 bg-bg-secondary/60 p-1 dark:border-neutral-600 dark:bg-neutral-800/60"
						role="group"
						aria-label="What to check"
					>
						<button
							type="button"
							id="moat-mode-termination"
							class="mode-btn rounded-lg px-4 py-2 text-sm font-medium transition-colors"
							aria-pressed="true"
						>
							Termination
						</button>
						<button
							type="button"
							id="moat-mode-property"
							class="mode-btn rounded-lg px-4 py-2 text-sm font-medium transition-colors"
							aria-pressed="false"
						>
							LTL Property
						</button>
					</div>
					<p id="moat-mode-hint" class="text-xs text-neutral-500 dark:text-neutral-400"></p>
				</div>

				<!-- The question -->
				<fieldset
					id="moat-query"
					class="mb-5 rounded-xl border border-primary/10 bg-bg-primary/50 p-5 transition-opacity dark:border-neutral-700 dark:bg-neutral-800/30"
				>
					<legend class="sr-only">The property to check</legend>

					<label for="moat-formula" class="moat-label">LTL formula</label>
					<div class="moat-editor" data-editor>
						<pre class="moat-layer moat-highlight" aria-hidden="true" data-highlight></pre>
						<textarea
							id="moat-formula"
							name="formula"
							rows="2"
							spellcheck="false"
							autocomplete="off"
							autocapitalize="off"
							autocorrect="off"
							data-symbols
							class="moat-layer moat-input"></textarea>
					</div>

					<div class="mt-4 grid gap-4 sm:grid-cols-2">
						<div>
							<label for="moat-variables" class="moat-label">Variables</label>
							<input
								id="moat-variables"
								name="variables"
								type="text"
								spellcheck="false"
								autocomplete="off"
								autocapitalize="off"
								autocorrect="off"
								placeholder="x y"
								class="moat-layer moat-input w-full"
							/>
							<p class="mt-1.5 text-xs text-neutral-500 dark:text-neutral-400">
								The order in which the formula's variables map onto the program's.
							</p>
						</div>
						<div>
							<label for="moat-precondition" class="moat-label">Precondition</label>
							<div class="moat-editor" data-editor>
								<pre class="moat-layer moat-highlight" aria-hidden="true" data-highlight></pre>
								<textarea
									id="moat-precondition"
									name="precondition"
									rows="1"
									spellcheck="false"
									autocomplete="off"
									autocapitalize="off"
									autocorrect="off"
									placeholder="'x > 0'"
									data-symbols
									class="moat-layer moat-input"></textarea>
							</div>
							<p class="mt-1.5 text-xs text-neutral-500 dark:text-neutral-400">
								Optional constraint on the initial state.
							</p>
						</div>
					</div>

					<p class="mt-4 text-xs leading-relaxed text-neutral-500 dark:text-neutral-400">
						<span class="font-medium text-neutral-600 dark:text-neutral-300">Operators</span>{" "}
						&mdash; temporal {
							temporalOperators.map((operator, index) => (
								<>
									{separator(index, temporalOperators.length)}
									<code class="moat-op">{operator}</code>
								</>
							))
						}; boolean {
							booleanOperators.map((operator, index) => (
								<>
									{separator(index, booleanOperators.length)}
									<code class="moat-key">{operator}</code>
								</>
							))
						}.
					</p>
					<p
						id="moat-query-error"
						role="alert"
						class="mt-3 hidden rounded-lg bg-red-500/10 px-3 py-2 text-xs text-red-600 dark:bg-red-400/10 dark:text-red-300"
					>
					</p>
				</fieldset>

				<!-- Actions -->
				<div class="flex flex-wrap items-center gap-3">
					<button
						type="submit"
						id="moat-submit"
						class="inline-flex items-center gap-2 rounded-xl bg-btn-primary px-5 py-3 text-sm font-medium text-btn-primary-text shadow-[0px_2px_3px_0_rgba(0,0,0,0.1)] transition duration-300 hover:-translate-y-0.5 hover:bg-btn-primary-hover disabled:cursor-not-allowed disabled:opacity-50 disabled:hover:translate-y-0 dark:bg-btn-primary-dark dark:hover:bg-btn-primary-dark-hover"
					>
						<Play class="h-4 w-4" />
						<span id="moat-submit-label">Check termination</span>
					</button>
					<button
						type="button"
						id="moat-cancel"
						class="hidden items-center gap-2 rounded-xl border border-neutral-300 px-5 py-3 text-sm font-medium text-neutral-700 transition duration-300 hover:border-primary hover:text-primary dark:border-neutral-600 dark:text-neutral-200 dark:hover:border-primary-light dark:hover:text-primary-light"
					>
						<CircleStop class="h-4 w-4" />
						Cancel
					</button>
					<p
						id="moat-status"
						role="status"
						aria-live="polite"
						class="text-sm text-neutral-500 dark:text-neutral-400"
					>
					</p>
				</div>
			</form>

			<!-- Result -->
			<section id="moat-result" class="mt-8 hidden">
				<div
					class="rounded-xl border border-primary/10 bg-bg-primary/50 p-5 dark:border-neutral-700 dark:bg-neutral-800/30"
				>
					<div class="flex flex-wrap items-center gap-3">
						<span id="moat-verdict" class="rounded-md px-2.5 py-1 font-mono text-xs font-semibold"
						></span>
						<p id="moat-verdict-text" class="text-sm text-neutral-600 dark:text-neutral-300"></p>
					</div>
					<p id="moat-runtime" class="mt-3 text-xs text-neutral-500 dark:text-neutral-400"></p>
					<button
						type="button"
						id="moat-open-proof"
						class="mt-4 hidden items-center gap-1.5 rounded-lg border border-primary/20 bg-bg-secondary/60 px-3 py-2 text-xs font-medium text-neutral-700 transition-colors hover:border-primary hover:text-primary dark:border-neutral-600 dark:bg-neutral-800/60 dark:text-neutral-200 dark:hover:border-primary-light dark:hover:text-primary-light"
					>
						<ExternalLink class="h-3.5 w-3.5" />
						Open proof in a new tab
					</button>
					<!-- Only used when the browser refuses to open the tab. -->
					<details id="moat-output-wrapper" class="mt-4 hidden">
						<summary
							class="cursor-pointer text-sm font-medium text-primary hover:underline dark:text-primary-light"
						>
							Proof output
						</summary>
						<div class="mt-3 overflow-x-auto rounded-lg bg-neutral-900 p-4 dark:bg-neutral-950">
							<pre
								id="moat-output"
								class="whitespace-pre font-mono text-[12.5px] leading-relaxed text-neutral-100"></pre>
						</div>
					</details>
				</div>
			</section>

			<!-- Same run on the command line -->
			<section class="mt-12">
				<h2 class="mb-3 font-brand text-2xl tracking-normal">The same run locally</h2>
				<p class="mb-4 text-sm leading-relaxed text-neutral-600 dark:text-neutral-300">
					The web interface passes no options of its own beyond the timeout, so a local MoAT gives the
					same answer for the same input:
				</p>
				<div class="overflow-x-auto rounded-lg bg-neutral-900 p-4 dark:bg-neutral-950">
					<pre
						id="moat-cli"
						class="whitespace-pre font-mono text-[12.5px] leading-relaxed text-neutral-100"></pre>
				</div>
				<p class="mt-4 text-sm leading-relaxed text-neutral-600 dark:text-neutral-300">
					See <a
						href="/getting_started/"
						class="font-medium text-primary hover:underline dark:text-primary-light"
						>Getting Started</a
					> for what MoAT takes as input and what its answers mean.
				</p>
			</section>
		</div>
	</main>

	<script id="moat-examples" type="application/json" is:inline set:html={JSON.stringify(examples)}
	></script>

	<style is:global>
		/* The highlighted <pre> sits exactly behind the textarea, so every
		   metric that decides where a glyph lands must be shared. Utilities on
		   the two elements separately would drift the moment one changes. */
		.moat-editor {
			position: relative;
		}

		.moat-layer {
			margin: 0;
			display: block;
			width: 100%;
			border: 1px solid transparent;
			border-radius: 0.5rem;
			padding: 0.5rem 0.75rem;
			font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
			font-size: 13px;
			line-height: 1.6;
			white-space: pre-wrap;
			overflow-wrap: break-word;
			word-break: break-word;
			tab-size: 2;
		}

		.moat-highlight {
			position: absolute;
			inset: 0;
			overflow: hidden;
			pointer-events: none;
			color: rgb(38 45 56);
		}

		.moat-input {
			position: relative;
			resize: none;
			background-color: #fff;
			border-color: rgba(var(--color-primary-rgb), 0.15);
			outline: none;
			transition: border-color 150ms;
			color: rgb(38 45 56);
		}

		.moat-input:focus {
			border-color: rgba(var(--color-primary-rgb), 0.5);
		}

		/* Inside an editor the text itself is drawn by the layer underneath. */
		.moat-editor .moat-input {
			background-color: transparent;
			color: transparent;
			caret-color: var(--color-neutral-800);
		}

		.moat-editor .moat-highlight {
			background-color: #fff;
			border-color: rgba(var(--color-primary-rgb), 0.15);
		}

		.moat-editor:focus-within .moat-highlight {
			border-color: rgba(var(--color-primary-rgb), 0.5);
		}

		.moat-input::placeholder {
			color: var(--color-neutral-400);
		}

		.moat-editor .moat-input::placeholder {
			color: transparent;
		}

		.moat-placeholder {
			color: var(--color-neutral-400);
		}

		.moat-input::selection {
			background-color: rgba(var(--color-primary-rgb), 0.3);
		}

		html.dark .moat-highlight,
		html.dark .moat-input {
			color: var(--color-neutral-100);
		}

		html.dark .moat-input,
		html.dark .moat-editor .moat-highlight {
			background-color: rgba(9, 13, 20, 0.6);
			border-color: var(--color-neutral-700);
		}

		html.dark .moat-editor .moat-input {
			background-color: transparent;
			color: transparent;
			caret-color: var(--color-neutral-100);
		}

		/* Temporal operators, the part of a formula worth finding at a glance. */
		.moat-tok-temporal {
			color: var(--color-primary);
			font-weight: 600;
		}

		html.dark .moat-tok-temporal {
			color: var(--color-primary-light);
		}

		.moat-tok-atom {
			color: var(--color-neutral-500);
		}

		html.dark .moat-tok-atom {
			color: var(--color-neutral-400);
		}

		.moat-label {
			display: block;
			margin-bottom: 0.375rem;
			font-size: 0.75rem;
			font-weight: 500;
			text-transform: uppercase;
			letter-spacing: 0.05em;
			color: var(--color-neutral-500);
		}

		html.dark .moat-label {
			color: var(--color-neutral-400);
		}

		.moat-op,
		.moat-key {
			border-radius: 0.25rem;
			padding: 0.05rem 0.3rem;
			font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
			font-size: 0.75rem;
		}

		.moat-op {
			background-color: rgba(var(--color-primary-rgb), 0.1);
			color: var(--color-primary);
			font-weight: 600;
		}

		html.dark .moat-op {
			background-color: rgba(var(--color-primary-rgb), 0.2);
			color: var(--color-primary-light);
		}

		.moat-key {
			background-color: rgba(var(--color-primary-rgb), 0.07);
			color: var(--color-neutral-600);
		}

		html.dark .moat-key {
			background-color: rgba(255, 255, 255, 0.06);
			color: var(--color-neutral-300);
		}

		/* Termination mode: the question is fixed, so the fields are inert. */
		#moat-query:disabled,
		#moat-query[disabled] {
			opacity: 0.55;
		}

		#moat-query[disabled] .moat-input {
			cursor: not-allowed;
		}

		.mode-btn[aria-pressed="false"] {
			color: var(--color-neutral-600);
		}

		html.dark .mode-btn[aria-pressed="false"] {
			color: var(--color-neutral-300);
		}

		.mode-btn[aria-pressed="false"]:hover {
			color: var(--color-primary);
		}

		.mode-btn[aria-pressed="true"] {
			background-color: var(--color-primary);
			color: #fff;
		}
	</style>

	<script>
		type Verdict = "verified" | "refuted" | "unknown" | "timeout" | "error";

		interface Query {
			formula: string;
			variables: string;
			precondition: string;
		}

		interface CheckResult {
			verdict: string;
			answer: string | null;
			output: string;
			truncated: boolean;
			runtime_seconds: number;
			message: string | null;
		}

		interface JobState {
			id: string;
			status: "queued" | "running" | "done" | "cancelled";
			queue_position: number;
			query?: Query;
			result: CheckResult | null;
		}

		interface Example extends Query {
			name: string;
			mode: string;
			program: string;
		}

		const formElement = document.getElementById("moat-form") as HTMLFormElement | null;
		if (formElement) {
			const form = formElement;
			const api = (form.dataset.api ?? "").replace(/\/$/, "");
			const programField = document.getElementById("moat-program") as HTMLTextAreaElement;
			const formulaField = document.getElementById("moat-formula") as HTMLTextAreaElement;
			const variablesField = document.getElementById("moat-variables") as HTMLInputElement;
			const preconditionField = document.getElementById(
				"moat-precondition"
			) as HTMLTextAreaElement;
			const queryBox = document.getElementById("moat-query") as HTMLFieldSetElement;
			const queryError = document.getElementById("moat-query-error") as HTMLElement;
			const timeoutField = document.getElementById("moat-timeout") as HTMLInputElement;
			const timeoutHint = document.getElementById("moat-timeout-hint") as HTMLElement;
			const sizeHint = document.getElementById("moat-size") as HTMLElement;
			const submitButton = document.getElementById("moat-submit") as HTMLButtonElement;
			const submitLabel = document.getElementById("moat-submit-label") as HTMLElement;
			const cancelButton = document.getElementById("moat-cancel") as HTMLButtonElement;
			const statusLine = document.getElementById("moat-status") as HTMLElement;
			const resultPanel = document.getElementById("moat-result") as HTMLElement;
			const verdictBadge = document.getElementById("moat-verdict") as HTMLElement;
			const verdictText = document.getElementById("moat-verdict-text") as HTMLElement;
			const runtimeLine = document.getElementById("moat-runtime") as HTMLElement;
			const proofButton = document.getElementById("moat-open-proof") as HTMLButtonElement;
			const outputWrapper = document.getElementById("moat-output-wrapper") as HTMLDetailsElement;
			const outputBlock = document.getElementById("moat-output") as HTMLElement;
			const fileInput = document.getElementById("moat-file") as HTMLInputElement;
			const cliBlock = document.getElementById("moat-cli") as HTMLElement;
			const modeHint = document.getElementById("moat-mode-hint") as HTMLElement;
			const terminationButton = document.getElementById(
				"moat-mode-termination"
			) as HTMLButtonElement;
			const propertyButton = document.getElementById("moat-mode-property") as HTMLButtonElement;

			const examples = JSON.parse(
				document.getElementById("moat-examples")?.textContent ?? "[]"
			) as Example[];

			// Overwritten by /api/v1/info; these are only what the page shows
			// before the server has answered.
			let maxProgramBytes = 65536;
			let terminationFormula = "F 'AT(l_TERM)'";
			let temporal = new Set(["X", "F", "G", "U", "R", "UDC", "RDC", "UC", "RC", "FC", "GC"]);
			let apiAvailable = true;
			let mode: "termination" | "property" = "termination";
			let currentJob: string | null = null;
			let poller: number | null = null;
			let lastResult: CheckResult | null = null;
			let lastQuery: Query | null = null;

			// MoAT's own spellings, and what the editor shows instead. `<->`
			// comes first so that it is not eaten as `<` followed by `->`; the
			// comparisons share no prefix with the connectives, so their place
			// in the list does not matter.
			const SYMBOLS: Array<[string, string]> = [
				["<->", "↔"],
				["->", "→"],
				["&&", "∧"],
				["||", "∨"],
				["<=", "≤"],
				[">=", "≥"],
			];

			// MoAT's lexer has no biconditional (src/parse/lexer.cpp): it knows
			// &&, ||, ->, and NOT. The editor still shows ↔ for `<->` so that
			// typing it is not silently swallowed, but the run is blocked here
			// rather than sent off to come back as a parse error.
			const BICONDITIONAL = "↔";

			const VERDICTS: Record<Verdict, { label: string; tone: string }> = {
				// The palette of the Output section on /getting_started/.
				verified: {
					label: "Yes",
					tone: "bg-green-500/10 text-green-600 dark:bg-green-400/10 dark:text-green-300",
				},
				refuted: {
					label: "No",
					tone: "bg-red-500/10 text-red-500 dark:bg-red-400/10 dark:text-red-300",
				},
				unknown: {
					label: "Unknown",
					tone: "bg-primary/10 text-primary dark:bg-primary/20 dark:text-primary-light",
				},
				timeout: {
					label: "Timeout",
					tone: "bg-amber-500/10 text-amber-600 dark:bg-amber-400/10 dark:text-amber-300",
				},
				error: {
					label: "Error",
					tone: "bg-red-500/10 text-red-500 dark:bg-red-400/10 dark:text-red-300",
				},
			};

			// `terminating`/`nonterminating` are what the service answered before
			// the formula became part of the request; accepting both means the
			// page and the service can be deployed in either order.
			const VERDICT_ALIASES: Record<string, Verdict> = {
				verified: "verified",
				terminating: "verified",
				refuted: "refuted",
				nonterminating: "refuted",
				unknown: "unknown",
				timeout: "timeout",
				error: "error",
			};

			function explain(verdict: Verdict, forTermination: boolean): string {
				switch (verdict) {
					case "verified":
						return forTermination
							? "MoAT verified the formula: every run reaches the termination location, so the program terminates."
							: "MoAT verified the formula: it holds on every run of the program.";
					case "refuted":
						return forTermination
							? "MoAT refuted the formula: there is a run that never terminates."
							: "MoAT refuted the formula: there is a run on which it does not hold.";
					case "unknown":
						return "Neither backend reached a conclusion. Fair termination is undecidable in general, so this is a possible outcome for any input.";
					case "timeout":
						return "The analysis hit its time limit. A longer timeout may help.";
					default:
						return "MoAT could not analyze this input.";
				}
			}

			// --- the formula editor -------------------------------------------

			const toUnicode = (text: string) =>
				SYMBOLS.reduce((out, [ascii, symbol]) => out.split(ascii).join(symbol), text);

			const toAscii = (text: string) =>
				SYMBOLS.reduce((out, [ascii, symbol]) => out.split(symbol).join(ascii), text);

			const escapeHtml = (text: string) =>
				text.replace(
					/[&<>"']/g,
					(character) =>
						({
							"&": "&amp;",
							"<": "&lt;",
							">": "&gt;",
							'"': "&quot;",
							"'": "&#39;",
						})[character] as string
				);

			/** Colours the temporal operators, leaving quoted atoms alone. */
			function highlight(text: string): string {
				let html = "";
				let index = 0;
				while (index < text.length) {
					const character = text[index];
					// An atom runs to the closing quote, so an `F` inside one is
					// part of a variable name and not an operator.
					if (character === "'") {
						let end = index + 1;
						while (end < text.length && text[end] !== "'") end += 1;
						const atom = text.slice(index, Math.min(end + 1, text.length));
						html += `<span class="moat-tok-atom">${escapeHtml(atom)}</span>`;
						index = end + 1;
						continue;
					}
					if (/[A-Za-z_]/.test(character)) {
						let end = index;
						while (end < text.length && /[A-Za-z0-9_.]/.test(text[end])) end += 1;
						const word = text.slice(index, end);
						html += temporal.has(word)
							? `<span class="moat-tok-temporal">${word}</span>`
							: escapeHtml(word);
						index = end;
						continue;
					}
					html += escapeHtml(character);
					index += 1;
				}
				return html;
			}

			function paint(field: HTMLTextAreaElement) {
				const layer = field.parentElement?.querySelector("[data-highlight]") as HTMLElement | null;
				if (!layer) return;
				if (field.value === "" && field.placeholder) {
					layer.innerHTML = `<span class="moat-placeholder">${escapeHtml(field.placeholder)}</span>`;
				} else {
					// The trailing newline keeps a final empty line visible.
					layer.innerHTML = `${highlight(field.value)}\n`;
				}
				layer.scrollTop = field.scrollTop;
				layer.scrollLeft = field.scrollLeft;
			}

			/**
			 * Rewrites what was typed into the symbols the editor shows.
			 *
			 * The prefix up to the caret is converted on its own, so the new
			 * caret is simply its length: every substitution is shorter than
			 * what it replaces, and counting the difference by hand would go
			 * wrong the moment a formula holds more than one of them.
			 */
			function applySymbols(field: HTMLTextAreaElement | HTMLInputElement) {
				const caret = field.selectionStart ?? field.value.length;
				const before = toUnicode(field.value.slice(0, caret));
				const rewritten = before + toUnicode(field.value.slice(caret));
				if (rewritten !== field.value) {
					field.value = rewritten;
					field.setSelectionRange(before.length, before.length);
				}
			}

			// --- what is being asked ------------------------------------------

			function currentQuery(): Query {
				if (mode === "termination") {
					return { formula: terminationFormula, variables: "", precondition: "" };
				}
				return {
					formula: toAscii(formulaField.value).trim(),
					variables: variablesField.value.trim().split(/\s+/).filter(Boolean).join(" "),
					precondition: toAscii(preconditionField.value).trim(),
				};
			}

			function quote(value: string) {
				return `"${value.replace(/"/g, '\\"')}"`;
			}

			function updateCli() {
				const query = currentQuery();
				let command = `moat -i program.ari --ltl-formula=${quote(query.formula)}`;
				command += ` --variables=${quote(query.variables)}`;
				if (query.precondition) command += ` --precondition=${quote(query.precondition)}`;
				command += " --format ari";
				cliBlock.textContent = command;
			}

			/** The reason the query cannot be sent, or "". */
			function queryProblem(): string {
				if (mode === "termination") return "";
				const query = currentQuery();
				if (!query.formula) return "Enter an LTL formula, or switch back to Termination.";
				if (formulaField.value.includes(BICONDITIONAL) || query.formula.includes("<->")) {
					return "MoAT has no biconditional. Write ↔ as two implications, for example ('a' -> 'b') && ('b' -> 'a').";
				}
				if (preconditionField.value.includes(BICONDITIONAL)) {
					return "MoAT has no biconditional. Write ↔ as two implications in the precondition too.";
				}
				const names = query.variables ? query.variables.split(" ") : [];
				const bad = names.find((name) => !/^[A-Za-z_][A-Za-z0-9_.]*$/.test(name));
				if (bad) return `"${bad}" is not a variable name; write the list as a space-separated order.`;
				return "";
			}

			const byteLength = (text: string) => new TextEncoder().encode(text).length;

			function refresh() {
				const size = byteLength(programField.value);
				const overLimit = size > maxProgramBytes;
				sizeHint.textContent = `${size.toLocaleString()} of ${maxProgramBytes.toLocaleString()} bytes`;
				// Inline, so it wins over the element's own text colour without
				// depending on the order Tailwind emits the two utilities in.
				sizeHint.style.color = overLimit ? "#ef4444" : "";

				const problem = queryProblem();
				queryError.textContent = problem;
				queryError.classList.toggle("hidden", problem === "");

				submitButton.disabled =
					!apiAvailable ||
					currentJob !== null ||
					overLimit ||
					problem !== "" ||
					programField.value.trim() === "";
				updateCli();
			}

			function setMode(next: "termination" | "property") {
				mode = next;
				form.dataset.mode = next;
				const fixed = next === "termination";

				terminationButton.setAttribute("aria-pressed", String(fixed));
				propertyButton.setAttribute("aria-pressed", String(!fixed));
				// A disabled fieldset makes every control inside it inert, which
				// is what "grayed out" should mean for a screen reader as much
				// as for the eye. Setting it reflects the attribute the CSS
				// below dims on.
				queryBox.disabled = fixed;
				submitLabel.textContent = fixed ? "Check termination" : "Check property";
				modeHint.textContent = fixed
					? `Fixed formula ${terminationFormula} — the program terminates exactly when it holds.`
					: "Any formula MoAT accepts, over the variables listed below.";

				if (fixed) {
					formulaField.value = terminationFormula;
					variablesField.value = "";
					preconditionField.value = "";
				}
				paint(formulaField);
				paint(preconditionField);
				refresh();
			}

			function setStatus(message: string) {
				statusLine.textContent = message;
			}

			// --- results --------------------------------------------------------

			function showResult(result: CheckResult, query: Query) {
				lastResult = result;
				lastQuery = query;
				const verdict = VERDICT_ALIASES[result.verdict] ?? "error";
				const shape = VERDICTS[verdict];
				verdictBadge.className = `rounded-md px-2.5 py-1 font-mono text-xs font-semibold ${shape.tone}`;
				verdictBadge.textContent = shape.label;
				verdictText.textContent =
					verdict === "error" && result.message
						? result.message
						: explain(verdict, query.formula === terminationFormula);

				const parts: string[] = [];
				if (result.answer) parts.push(`MoAT answered “${result.answer}”`);
				if (result.runtime_seconds) parts.push(`${result.runtime_seconds.toFixed(1)} s`);
				if (result.truncated) parts.push("output truncated");
				runtimeLine.textContent = parts.join(" · ");

				const output = (result.output ?? "").trim();
				proofButton.classList.toggle("hidden", output === "");
				proofButton.classList.toggle("inline-flex", output !== "");
				// Stays hidden unless the browser refuses to open the tab.
				outputWrapper.classList.add("hidden");
				outputBlock.textContent = output;
				resultPanel.classList.remove("hidden");
			}

			function showError(message: string, query: Query) {
				showResult(
					{
						verdict: "error",
						answer: null,
						output: "",
						truncated: false,
						runtime_seconds: 0,
						message,
					},
					query
				);
			}

			/** The standalone page the proof opens in. */
			function proofDocument(result: CheckResult, query: Query): string {
				const verdict = VERDICT_ALIASES[result.verdict] ?? "error";
				const label = VERDICTS[verdict].label;
				const colors: Record<string, string> = {
					verified: "#16a34a",
					refuted: "#ef4444",
					unknown: "#2d6dc3",
					timeout: "#d97706",
					error: "#ef4444",
				};
				const rows: Array<[string, string]> = [["Formula", query.formula]];
				if (query.variables) rows.push(["Variables", query.variables]);
				if (query.precondition) rows.push(["Precondition", query.precondition]);
				if (result.answer) rows.push(["MoAT answered", result.answer]);
				if (result.runtime_seconds)
					rows.push(["Runtime", `${result.runtime_seconds.toFixed(1)} s`]);
				if (result.truncated) rows.push(["Note", "the output was truncated"]);

				return `<!doctype html>
<html lang="en"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>MoAT proof — ${escapeHtml(label)}</title>
<style>
  :root { color-scheme: light dark; --fg:#2c3542; --bg:#fdfaf5; --card:#fff; --line:rgba(45,109,195,.15); --muted:#677487; }
  @media (prefers-color-scheme: dark) {
    :root { --fg:#edf1f8; --bg:#0b1220; --card:#0f1b2d; --line:#3f4a5a; --muted:#92a1b7; }
  }
  body { margin:0; padding:2rem 1.5rem; background:var(--bg); color:var(--fg);
         font-family: ui-sans-serif, system-ui, -apple-system, Segoe UI, sans-serif; }
  main { max-width: 60rem; margin: 0 auto; }
  h1 { font-size:1.25rem; margin:0 0 1rem; display:flex; align-items:center; gap:.6rem; }
  .badge { border-radius:.375rem; padding:.15rem .55rem; font:600 .8rem/1.4 ui-monospace,Menlo,monospace;
           color:#fff; background:${colors[verdict]}; }
  dl { display:grid; grid-template-columns:max-content 1fr; gap:.4rem 1rem; margin:0 0 1.5rem;
       padding:1rem 1.25rem; background:var(--card); border:1px solid var(--line); border-radius:.75rem; }
  dt { color:var(--muted); font-size:.8rem; }
  dd { margin:0; font:.85rem/1.5 ui-monospace,Menlo,monospace; overflow-wrap:anywhere; }
  pre { background:#10161f; color:#edf1f8; padding:1.25rem; border-radius:.75rem;
        overflow-x:auto; font:12.5px/1.6 ui-monospace,Menlo,monospace; }
</style></head>
<body><main>
<h1><span class="badge">${escapeHtml(label)}</span> MoAT proof output</h1>
<dl>${rows
	.map(([key, value]) => `<dt>${escapeHtml(key)}</dt><dd>${escapeHtml(value)}</dd>`)
	.join("")}</dl>
<pre>${escapeHtml(result.output ?? "")}</pre>
</main></body></html>`;
			}

			proofButton.addEventListener("click", () => {
				if (!lastResult || !lastQuery) return;
				// Opened straight from the click, with the result already in
				// hand, so no popup blocker sees this as an unprompted tab.
				const page = new Blob([proofDocument(lastResult, lastQuery)], { type: "text/html" });
				const url = URL.createObjectURL(page);
				const tab = window.open(url, "_blank");
				if (!tab) {
					// Blocked anyway: fall back to showing it in place.
					URL.revokeObjectURL(url);
					outputWrapper.classList.remove("hidden");
					outputWrapper.open = true;
					return;
				}
				// Long enough for the new tab to have fetched it.
				window.setTimeout(() => URL.revokeObjectURL(url), 60_000);
			});

			// --- talking to the service ---------------------------------------

			function stopPolling() {
				if (poller !== null) window.clearInterval(poller);
				poller = null;
			}

			function finish() {
				stopPolling();
				currentJob = null;
				cancelButton.classList.add("hidden");
				cancelButton.classList.remove("inline-flex");
				refresh();
			}

			async function detailOf(response: Response, fallback: string) {
				try {
					const body = await response.json();
					return typeof body.detail === "string" ? body.detail : fallback;
				} catch {
					return fallback;
				}
			}

			async function loadInfo() {
				try {
					const response = await fetch(`${api}/api/v1/info`);
					if (!response.ok) throw new Error(String(response.status));
					const info = await response.json();
					const limits = info.limits;
					maxProgramBytes = limits.max_program_bytes;
					timeoutField.min = String(limits.min_timeout);
					timeoutField.max = String(limits.max_timeout);
					timeoutField.value = String(limits.default_timeout);
					timeoutHint.textContent = `seconds (${limits.min_timeout}–${limits.max_timeout})`;
					if (typeof info.formula === "string" && info.formula) terminationFormula = info.formula;
					if (Array.isArray(info.temporal_operators) && info.temporal_operators.length > 0) {
						temporal = new Set(info.temporal_operators as string[]);
					}
					apiAvailable = true;
					setMode(mode);
				} catch {
					// Keep the page useful while the backend is down: the form
					// stays editable and the local command line is below.
					apiAvailable = false;
					refresh();
					setStatus(
						"The analysis server is currently unavailable. You can still run MoAT locally — see the command below."
					);
				}
			}

			async function poll(id: string, startedAt: number, query: Query) {
				let response: Response;
				try {
					response = await fetch(`${api}/api/v1/jobs/${id}`);
				} catch {
					finish();
					showError("Lost contact with the analysis server.", query);
					return;
				}
				if (!response.ok) {
					finish();
					showError(await detailOf(response, "The analysis job could not be retrieved."), query);
					return;
				}

				const state = (await response.json()) as JobState;
				const elapsed = Math.round((Date.now() - startedAt) / 1000);
				if (state.status === "queued") {
					setStatus(`Queued, position ${state.queue_position}…`);
				} else if (state.status === "running") {
					setStatus(`Running MoAT… ${elapsed} s`);
				} else if (state.status === "cancelled") {
					finish();
					setStatus("Cancelled.");
				} else if (state.status === "done" && state.result) {
					finish();
					setStatus("");
					// The service echoes the query it ran; trust that over what
					// the form holds now, which the user may have edited since.
					showResult(state.result, state.query ?? query);
				}
			}

			form.addEventListener("submit", async (event) => {
				event.preventDefault();
				if (currentJob) return;

				const query = currentQuery();
				resultPanel.classList.add("hidden");
				submitButton.disabled = true;
				setStatus("Submitting…");

				let response: Response;
				try {
					response = await fetch(`${api}/api/v1/check`, {
						method: "POST",
						headers: { "Content-Type": "application/json" },
						body: JSON.stringify({
							program: programField.value,
							formula: query.formula,
							variables: query.variables,
							precondition: query.precondition,
							timeout: Number(timeoutField.value),
						}),
					});
				} catch {
					finish();
					setStatus("");
					showError("Could not reach the analysis server.", query);
					return;
				}

				if (!response.ok) {
					finish();
					setStatus("");
					showError(await detailOf(response, "The submission was rejected."), query);
					return;
				}

				const job = await response.json();
				currentJob = job.id;
				cancelButton.classList.remove("hidden");
				cancelButton.classList.add("inline-flex");

				const startedAt = Date.now();
				setStatus("Queued…");
				// Poll on a fixed cadence rather than a backoff: runs are bounded
				// by the timeout, so there is nothing long to back off from.
				poller = window.setInterval(() => poll(job.id, startedAt, query), 700);
				poll(job.id, startedAt, query);
			});

			cancelButton.addEventListener("click", async () => {
				if (!currentJob) return;
				const id = currentJob;
				stopPolling();
				setStatus("Cancelling…");
				try {
					await fetch(`${api}/api/v1/jobs/${id}`, { method: "DELETE" });
				} catch {
					/* the job dies with its timeout anyway */
				}
				finish();
				setStatus("Cancelled.");
			});

			// --- wiring ---------------------------------------------------------

			terminationButton.addEventListener("click", () => setMode("termination"));
			propertyButton.addEventListener("click", () => setMode("property"));

			for (const field of document.querySelectorAll<HTMLTextAreaElement>("[data-symbols]")) {
				field.addEventListener("input", () => {
					applySymbols(field);
					paint(field);
					refresh();
				});
				field.addEventListener("scroll", () => paint(field));
				// A newline would only be rejected by the server; formulas and
				// preconditions are single-line.
				field.addEventListener("keydown", (event) => {
					if (event.key === "Enter") event.preventDefault();
				});
			}

			variablesField.addEventListener("input", refresh);

			function applyExample(example: Example) {
				programField.value = example.program;
				setMode(example.mode === "property" ? "property" : "termination");
				if (example.mode === "property") {
					formulaField.value = toUnicode(example.formula);
					variablesField.value = example.variables;
					preconditionField.value = toUnicode(example.precondition);
					paint(formulaField);
					paint(preconditionField);
				}
				refresh();
			}

			for (const button of document.querySelectorAll<HTMLButtonElement>(".example-btn")) {
				button.addEventListener("click", () => {
					const example = examples[Number(button.dataset.example)];
					if (example) applyExample(example);
				});
			}

			document.getElementById("moat-reset")?.addEventListener("click", () => {
				resultPanel.classList.add("hidden");
				setStatus("");
				if (examples[0]) applyExample(examples[0]);
			});

			fileInput.addEventListener("change", async () => {
				const file = fileInput.files?.[0];
				if (!file) return;
				programField.value = await file.text();
				fileInput.value = "";
				refresh();
			});

			programField.addEventListener("input", refresh);

			programField.value = examples[0]?.program ?? "";
			setMode("termination");
			loadInfo();
		}
	</script>
</Layout>
